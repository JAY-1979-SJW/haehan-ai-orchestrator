{
  "model": "sonnet",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/ops/behavior_gate.py",
            "statusMessage": "행동 게이트 검사 중..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/ops/install_git_hooks.py",
            "statusMessage": "git hook 설치 중 (ruff + AI 검수)..."
          },
          {
            "type": "command",
            "command": "python -c \"import os;p='docs/worklog.md';print(''.join(open(p,encoding='utf-8').readlines()[:45])) if os.path.exists(p) else None\"",
            "statusMessage": "지난 작업 로그 확인 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import subprocess,sys,os;r=subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip();sys.exit(subprocess.run([sys.executable,os.path.join(r,'scripts','log_code_change.py')],stdin=sys.stdin).returncode)\""
          }
        ]
      }
    ]
  }
}
