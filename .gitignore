# 환경변수 및 민감 정보
.env
.env.local
*.pem
*.key
secrets/
.secrets/

# 운영 자격증명 — 실제 계정/해시 파일은 절대 커밋 금지 (샘플만 추적)
ai_orchestrator/policies/http_users.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
dist/
build/
*.egg-info/

# 테스트/커버리지
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# 런타임 산출물 (로그, 토큰 스토어, 실행 이력, 인박스 등) — ai_orchestrator 패키지
ai_orchestrator/storage/*.log
ai_orchestrator/storage/*.jsonl
ai_orchestrator/storage/*.json
!ai_orchestrator/storage/.gitkeep

# 사이트 자동화: 브라우저 세션 파일 및 스크린샷은 민감정보 (절대 커밋 금지)
# secrets/ 는 위에서 이미 ignore 되어 있지만, 명시적으로 재확인.
secrets/sites/
secrets/browser_state/
ai_orchestrator/storage/site_screenshots/

# 런타임 생성 파일 (root-level flat layout — dashboard/monitor 계통)
logs/
storage/
devlog/
