# haehan-ai-orchestrator 환경변수 예시
# 이 파일을 .env로 복사 후 실제 값 입력 (절대 Git에 커밋하지 말 것)

# ── OpenAI ───────────────────────────────────────────────────────────
# 설정 시 분류/요약 기능 활성화, 미설정 시 mock 모드로 동작
OPENAI_API_KEY=sk-proj-...

# ── 로깅 / 저장소 ────────────────────────────────────────────────────
LOG_LEVEL=INFO
# 비워두면 ai_orchestrator/storage/ 기본값 사용
# 컨테이너 환경: LOG_DIR=/app/ai_orchestrator/storage
LOG_DIR=

# ── 앱 바인딩 ────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8400

# ── HTTP Basic 인증 (orchestrator API) ──────────────────────────────
# 운영은 true 권장. false 면 dummy owner 로 동작.
AUTH_ENABLED=true
# 사용자/해시 파일 경로. 비우면 ai_orchestrator/policies/http_users.json 사용.
# 운영용 실제 파일은 리포지토리에 커밋 금지 (.gitignore 로 차단됨).
HTTP_USERS_PATH=

# ── Gmail OAuth2 ─────────────────────────────────────────────────────
# credentials.json: Google Cloud Console → OAuth2 클라이언트 → 다운로드
# token.json: 최초 인증 후 자동 생성
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=

# ── 운영 대시보드 Basic Auth (dashboard-monitor) ────────────────────
# 필수 — 미설정 시 모든 라우트 503 반환
ORCH_DASHBOARD_USER=admin
ORCH_DASHBOARD_PASSWORD=여기에_강한_비밀번호_입력

# ── 텔레그램 원격 승인 게이트 ───────────────────────────────────────
# @BotFather 에서 발급한 Bot API 토큰. 평문 값을 절대 커밋하지 않는다.
TELEGRAM_BOT_TOKEN=
# 승인 메시지를 받을 chat_id (개인 또는 그룹).
# TELEGRAM_CHAT_ID: dashboard-monitor 레거시 키, TELEGRAM_APPROVER_CHAT_ID: orchestrator 승인 게이트.
TELEGRAM_CHAT_ID=
TELEGRAM_APPROVER_CHAT_ID=
# 허용 텔레그램 사용자 매핑 파일. 비우면 ai_orchestrator/policies/telegram_users.json 사용.
TELEGRAM_USERS_PATH=

# ── 운영 감시기 (monitor.py) — 기본값으로 동작, 변경 시에만 설정 ─────
MONITOR_POLL_INTERVAL=2       # 파일 폴링 주기 (초)
MONITOR_ALERT_COOLDOWN=120    # 동일 에러 재발송 억제 (초)
MONITOR_APPROVAL_REMINDER=300 # 승인 미수신 재알림 간격 (초)
MONITOR_MAX_RETRY=3           # 실행 실패 시 최대 재시도 횟수

# ── 하이웍스 메일 수집 (POP3 포트 110, 읽기 전용 — IMAP 미지원) ─────
HIWORKS_MAIL_ACCOUNT=         # 하이웍스 계정 (예: user@company.com)
HIWORKS_MAIL_PASSWORD=        # 하이웍스 메일 비밀번호 (절대 Git에 커밋하지 말 것)
HIWORKS_FETCH_LIMIT=20        # 1회 수집 최대 건수 (기본 20, 최대 100)

# ── Hiworks 공식 API 연동 (1단계: 골격, dry_run 기본) ───────────────
# 실제 값은 https://developers.hiworks.com 공식 앱 등록/검수 후 발급되는 자격증명.
HIWORKS_BASE_URL=
HIWORKS_CLIENT_ID=
HIWORKS_CLIENT_SECRET=
HIWORKS_OFFICE_TOKEN=
# true 권장 (실제 호출 차단). 공식 호출 검증 단계에서만 false 로 전환.
HIWORKS_DRY_RUN=true

# ── 카카오워크 Bot 연동 ──────────────────────────────────────────────
KAKAOWORK_BOT_KEY=            # Bot webhook 서명 검증 secret (미설정 시 서명 검증 비활성)
KAKAOWORK_CHANNEL=kakaowork-default  # source_account 식별자

# ── 카카오톡 채널 연동 ───────────────────────────────────────────────
KAKAOTALK_CHANNEL_ID=kakaotalk-channel-default  # source_account 식별자

# ── Naver 검색 OpenAPI (블로그/쇼핑, 비로그인 공개 검색) ─────────────
# https://developers.naver.com 에서 애플리케이션 등록 후 발급되는 키.
NAVER_OPENAPI_BASE_URL=https://openapi.naver.com
NAVER_OPENAPI_CLIENT_ID=
NAVER_OPENAPI_CLIENT_SECRET=
# true 권장 (실제 호출 차단). 검증 단계에서만 false.
NAVER_OPENAPI_DRY_RUN=true

# ── Naver 검색 2단계: DB 적재 / 증분 상태 (선택적) ────────────────────
# true 일 때만 sqlite3 DB 에 적재. dry_run/unconfigured 에서는 write 없음.
NAVER_SEARCH_DB_ENABLED=false
NAVER_SEARCH_DB_PATH=         # 비우면 <repo>/data/naver_search.db
NAVER_SEARCH_STATE_PATH=      # 비우면 <repo>/data/naver_search_state.json

# ── Naver 검색 5단계: 운영 스케줄 ─────────────────────────────────────
NAVER_SEARCH_SCHEDULE_ENABLED=false    # true 면 서버 시작 시 백그라운드 수집
NAVER_SEARCH_SCHEDULE_INTERVAL_SEC=3600 # 수집 간격(초). 최소 60.
NAVER_BLOG_SEARCH_QUERIES=             # 콤마 분리. 비우면 skip.
NAVER_SHOPPING_SEARCH_QUERIES=
NAVER_SEARCH_RUN_LOG_PATH=             # 비우면 <repo>/data/naver_search_runs.jsonl

# ── YouTube Data API v3 (read-only PoC, 비OAuth) ───────────────────
# Google Cloud Console > APIs & Services 에서 YouTube Data API v3 활성화 후 발급된 API key.
# 본 PoC 는 search.list / videos.list read-only 만 사용. 업로드/수정/삭제/댓글 작성 금지.
YOUTUBE_DATA_API_KEY=
YOUTUBE_DATA_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_DATA_API_TIMEOUT_SECONDS=10.0

# YouTube captions OAuth (server-first baseline).
# Google Console OAuth client type: Web application.
# Authorized redirect URI must match the public server callback exactly.
YOUTUBE_CLIENT_SECRETS_FILE=/run/secrets/api/youtube_oauth_client.json
# 사용자 로컬 PC OS keyring에 저장한 OAuth client JSON 참조. 사용자별 설정에 사용.
YOUTUBE_CLIENT_SECRETS_REF=local-secret://youtube/oauth_client_json
YOUTUBE_OAUTH_REDIRECT_URI=https://haehan-ai.kr/orchestrator/api/v1/oauth/youtube/callback
YOUTUBE_OAUTH_TOKEN_FILE=/app/ai_orchestrator/storage/secrets/youtube_oauth_authorized_user.json
YOUTUBE_OAUTH_CALLBACK_EXCHANGE_ENABLED=true

# ── 브라우저 세션 (storageState) ─────────────────────────────────────
# 본인 소유 계정 전용. secrets/browser_state/ 에 자동 저장됨.
# 이 파일(.env)은 절대 Git에 커밋하지 말 것.
# 경로 override (기본값: secrets/browser_state/<site>.json):
BROWSER_STATE_ROOT=
# 경로 override (기본값: secrets/browser_profiles/<site>/):
BROWSER_PROFILES_ROOT=
# 전용 비밀번호/OTP 환경변수는 여기에 두지 않는다.
# 비밀번호 자동 입력 없음 — 초회 수동 로그인 후 storageState 재사용.

# 하나팩스 영업팩스 공통 첨부파일 경로 (PC마다 다름 — 각자 OneDrive 경로로 설정)
HANAFAX_DEFAULT_ATTACH_FILE=

# ── Instagram 댓글->키워드->비공개DM 자동화 (instagram_dm_router) ────
# Instagram API with Instagram Login 방식. graph.facebook.com이 아니라 graph.instagram.com 사용.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_REDIRECT_URI=https://haehan-ai.kr/orchestrator/api/v1/instagram-dm/oauth/callback
# 3단계 kill switch 중 GLOBAL — false면 계정/rule 설정과 무관하게 DM 미발송
INSTAGRAM_DM_ENABLED=false
# true면 Meta API를 호출하지 않고 DRY_RUN으로만 기록 (운영 전 필수 검증 모드)
INSTAGRAM_DM_DRY_RUN=true
