# haehan-ai-orchestrator 환경변수 예시
# 이 파일을 .env로 복사 후 실제 값 입력 (절대 Git에 커밋하지 말 것)

# 운영 대시보드 Basic Auth (필수 — 미설정 시 모든 라우트 503 반환)
ORCH_DASHBOARD_USER=admin
ORCH_DASHBOARD_PASSWORD=여기에_강한_비밀번호_입력

# 텔레그램 승인 알림 (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 운영 감시기 (monitor.py) — 기본값으로 동작하므로 변경 시에만 설정
MONITOR_POLL_INTERVAL=2       # 파일 폴링 주기 (초)
MONITOR_ALERT_COOLDOWN=120    # 동일 에러 재발송 억제 (초)
MONITOR_APPROVAL_REMINDER=300 # 승인 미수신 재알림 간격 (초)
MONITOR_MAX_RETRY=3           # 실행 실패 시 최대 재시도 횟수

# 하이웍스 메일 수집 (POP3 포트 110, 읽기 전용 — IMAP 미지원)
HIWORKS_MAIL_ACCOUNT=         # 하이웍스 계정 (예: user@company.com)
HIWORKS_MAIL_PASSWORD=        # 하이웍스 메일 비밀번호 (절대 Git에 커밋하지 말 것)
HIWORKS_FETCH_LIMIT=20        # 1회 수집 최대 건수 (기본 20, 최대 100)

# 카카오워크 Bot 연동
KAKAOWORK_BOT_KEY=            # Bot webhook 서명 검증 secret (미설정 시 서명 검증 비활성)
KAKAOWORK_CHANNEL=kakaowork-default  # source_account 식별자

# 카카오톡 채널 연동
KAKAOTALK_CHANNEL_ID=kakaotalk-channel-default  # source_account 식별자

# OpenAI (선택 — 미설정 시 분류 mock 모드로 동작)
OPENAI_API_KEY=               # sk-...
