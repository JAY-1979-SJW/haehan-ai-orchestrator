OPENAI_API_KEY=sk-proj-...

LOG_LEVEL=INFO
# 비워두면 ai_orchestrator/storage/ 기본값 사용
# 컨테이너 환경: LOG_DIR=/app/ai_orchestrator/storage
LOG_DIR=

APP_HOST=127.0.0.1
APP_PORT=8400

# HTTP Basic 인증 (true/false). 운영은 true 권장.
AUTH_ENABLED=false
# 사용자/해시 파일 경로. 비우면 ai_orchestrator/policies/http_users.json 사용.
# 운영용 실제 파일은 리포지토리에 커밋 금지 (.gitignore 로 차단됨).
HTTP_USERS_PATH=

# Gmail OAuth2 인증 파일 경로 (비워두면 storage/ 기본값 사용)
# credentials.json: Google Cloud Console → OAuth2 클라이언트 → 다운로드
# token.json: 최초 인증 후 자동 생성
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=
