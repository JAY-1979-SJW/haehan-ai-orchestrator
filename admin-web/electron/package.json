{
  "name": "haehan-ai-desktop",
  "version": "1.0.0",
  "description": "Haehan AI 데스크톱 앱",
  "author": "Haehan",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.haehan.ai",
    "productName": "Haehan AI",
    "directories": {
      "output": "../../dist-electron"
    },
    "files": [
      "main.js",
      "lib/**/*",
      "preload.js",
      "shell.html",
      "icon.png"
    ],
    "extraResources": [
      { "from": "../../scripts", "to": "scripts", "filter": ["local_agent.py"] },
      { "from": "../../dist/haehan-server", "to": "server/haehan-server" },
      { "from": "../../dist/nextjs/standalone", "to": "nextjs" }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "signingHashAlgorithms": [],
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ko_KR"
      ],
      "language": "1042"
    },
    "portable": {
      "artifactName": "HaehanAI-${version}-portable.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "electron-packager": "^17.1.2"
  }
}
