{
  "name": "haehan-ai-desktop",
  "version": "1.0.0",
  "description": "Haehan AI 데스크톱 앱",
  "author": "Haehan",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.haehan.ai",
    "productName": "Haehan AI",
    "directories": {
      "output": "../../dist-electron-new"
    },
    "files": [
      "main.js",
      "lib/**/*",
      "preload.js",
      "webview_preload.js",
      "shell.html",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../../scripts",
        "to": "scripts",
        "filter": [
          "local_agent.py"
        ]
      },
      {
        "from": "../../dist/haehan-server",
        "to": "server/haehan-server"
      },
      {
        "from": "../../dist/local-agent",
        "to": "local-agent"
      },
      {
        "from": "../../dist/haehan-mcp",
        "to": "mcp/haehan-mcp"
      },
      {
        "from": "../.next/standalone",
        "to": "nextjs",
        "filter": ["**/*"]
      },
      {
        "from": "../.next/standalone/node_modules",
        "to": "nextjs/node_modules",
        "filter": ["**/*"]
      },
      {
        "from": "../.next/static",
        "to": "nextjs/.next/static",
        "filter": ["**/*"]
      },
      {
        "from": "../public",
        "to": "nextjs/public",
        "filter": ["**/*"]
      },
      {
        "from": "build-info.json",
        "to": "build-info.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "artifactName": "HaehanAI-${env.HAEHAN_BUILD_VERSION}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ko_KR"
      ],
      "language": "1042"
    },
    "portable": {
      "artifactName": "HaehanAI-${env.HAEHAN_BUILD_VERSION}-portable.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2"
  }
}
