{
  "version": "1.0",
  "date": "2026-05-07",
  "description": "Browser Engine Capability Classification fixture",
  "cases": [
    {
      "id": "about_blank_server_playwright_allowed",
      "description": "about:blank는 서버 Playwright read-only 허용",
      "input": {
        "site_category": "test_page",
        "target_domain": "",
        "target_url": "about:blank",
        "operation_type": "read",
        "action_name": "browser.inspect",
        "production_mode": false
      },
      "expected_classification": "SERVER_PLAYWRIGHT_READONLY_ALLOWED",
      "expected_route": "SERVER_PLAYWRIGHT_READONLY",
      "expected_fallback_policy": {
        "fallback_allowed": true,
        "fallback_route": "LOCAL_AGENT_PLAYWRIGHT_READONLY"
      },
      "expected_security_policy": {
        "safe_to_execute": false,
        "server_playwright_allowed": true
      }
    },
