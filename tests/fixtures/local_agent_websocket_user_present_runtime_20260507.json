  "description": "Local Agent WebSocket User-Present Runtime fixture",
  "cases": [
    {
      "id": "websocket_receives_user_present_task",
      "description": "websocket_client이 USER_PRESENT_TASK 메시지를 인식하고 처리",
      "input": {
        "type": "user_present_task",
        "task": {
          "message_type": "USER_PRESENT_TASK",
          "workflow_run_id": "wr_rt_001",
          "workflow_id": "w1",
          "tenant_id": "t1",
          "user_id": "u1",
          "site_id": "s_bank",
          "site_category": "bank",
          "target_domain": "kbstar.com",
          "target_url_redacted": "https://kbstar.com/***",
          "target_url_hash": "abc123",
          "auth_method_label": "공동인증서/공인인증서",
          "user_message_ko": "은행 사이트 접속에 사용자 직접 인증이 필요합니다.",
          "required_user_actions": ["직접 인증 후 완료 클릭"],
          "blocked_ai_actions": ["자동 입력 금지"],
          "safe_to_execute": false,
          "created_at": "2026-05-07T00:00:00+00:00"
        }
      },
      "expected_local_state": {
        "state": "WAITING_FOR_USER",
        "safe_to_execute": false
      },
      "expected_ws_event": {
        "type": "user_present_ack",
        "status": "WAITING_FOR_USER",
        "safe_to_execute": false
      },
      "expected_server_response": null,
      "expected_security_policy": {
        "safe_to_execute": false,
        "no_browser_action": true
      }
    },
