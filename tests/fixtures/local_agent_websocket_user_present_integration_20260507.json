    {
      "id": "bank_user_present_task_message",
      "description": "은행 user-present task message 생성",
      "input": {
        "workflow_run_id": "wr_bank_001",
        "workflow_id": "w1",
        "tenant_id": "t1",
        "user_id": "u1",
        "site_id": "s_bank",
        "site_category": "bank",
        "target_domain": "kbstar.com",
        "target_url": "https://kbstar.com/login",
        "auth_methods": ["certificate"]
      },
      "expected_task_message": {
        "message_type": "USER_PRESENT_TASK",
        "safe_to_execute": false
      },
      "expected_local_task": {
        "state": "WAITING_FOR_USER",
        "safe_to_execute": false
      },
      "expected_status_event": {
        "message_type": "USER_PRESENT_STATUS",
        "status": "WAITING_FOR_USER",
        "safe_to_execute": false
      },
      "expected_security_policy": {
        "target_url_absent": true,
        "password_absent": true,
        "safe_to_execute": false
      }
    },
