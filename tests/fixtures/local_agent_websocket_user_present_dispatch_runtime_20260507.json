{
  "version": "1.0",
  "date": "2026-05-07",
  "description": "Local Agent WebSocket User-Present Dispatch Runtime fixture",
  "cases": [
    {
      "id": "should_dispatch_when_user_present_required",
      "description": "DRYRUN_LOCAL_SYSTEM_BROWSER_USER_PRESENT_REQUIRED → dispatch=True",
      "input": {
        "dryrun_result": {
          "dispatch_decision": "DRYRUN_LOCAL_SYSTEM_BROWSER_USER_PRESENT_REQUIRED"
        }
      },
      "expected": {
        "should_dispatch": true
      }
    },
    {
      "id": "should_not_dispatch_server_playwright",
      "description": "SERVER_PLAYWRIGHT_READONLY_READY → dispatch=False",
      "input": {
        "dryrun_result": {
          "dispatch_decision": "DRYRUN_SERVER_PLAYWRIGHT_READONLY_READY"
        }
      },
      "expected": {
        "should_dispatch": false
      }
    },
    {
      "id": "should_not_dispatch_blocked",
      "description": "BLOCKED → dispatch=False",
      "input": {
        "dryrun_result": {
          "dispatch_decision": "DRYRUN_BLOCKED"
        }
      },
      "expected": {
        "should_dispatch": false
      }
    },
    {
      "id": "should_not_dispatch_api_connector",
      "description": "API_CONNECTOR_REQUIRED → dispatch=False",
      "input": {
        "dryrun_result": {
          "dispatch_decision": "DRYRUN_API_CONNECTOR_REQUIRED"
        }
      },
      "expected": {
        "should_dispatch": false
      }
    },
    {
      "id": "should_not_dispatch_manual_review",
      "description": "MANUAL_REVIEW_REQUIRED → dispatch=False",
      "input": {
        "dryrun_result": {
          "dispatch_decision": "DRYRUN_MANUAL_REVIEW_REQUIRED"
        }
      },
      "expected": {
        "should_dispatch": false
      }
    },
    {
      "id": "dispatch_context_eligible",
      "description": "USER_PRESENT_REQUIRED → dispatch_context.dispatch_eligible=True, safe_to_execute=False",
      "input": {
        "workflow_run_id": "wr_dc_001",
        "tenant_id": "t1",
        "user_id": "u1",
        "site_id": "s_bank",
        "selected_agent_id": "agent_001",
        "dryrun_result": {
          "dispatch_decision": "DRYRUN_LOCAL_SYSTEM_BROWSER_USER_PRESENT_REQUIRED"
        }
      },
      "expected": {
        "dispatch_eligible": true,
        "safe_to_execute": false
      }
    },
    {
      "id": "dispatch_context_not_eligible",
      "description": "BLOCKED → dispatch_context.dispatch_eligible=False",
      "input": {
        "workflow_run_id": "wr_dc_002",
        "tenant_id": "t1",
        "user_id": "u1",
        "site_id": "s1",
        "selected_agent_id": "agent_001",
        "dryrun_result": {
          "dispatch_decision": "DRYRUN_BLOCKED"
        }
      },
      "expected": {
        "dispatch_eligible": false,
        "safe_to_execute": false
      }
    },
    {
      "id": "build_task_from_dryrun_valid",
      "description": "dryrun_result → USER_PRESENT_TASK message 생성",
      "input": {
        "dispatch_decision": "DRYRUN_LOCAL_SYSTEM_BROWSER_USER_PRESENT_REQUIRED",
        "workflow_run_id": "wr_bt_001",
        "workflow_id": "w1",
        "tenant_id": "t1",
        "user_id": "u1",
        "site_id": "s_bank",
        "user_message_ko": "은행 사이트 접속에 사용자 직접 인증이 필요합니다.",
