{
  "fixture_id": "BROWSER_SITE_COMPLIANCE_POLICY_1",
  "version": "1.0",
  "created_at": "2026-05-07",
  "description": "Site compliance policy test cases covering Google services, restricted sites, and capability classifications",
  "cases": [
    {
      "case_id": "google_accounts_login_blocked",
      "description": "Google 로그인은 자동화 금지, OAuth consent 필요",
      "input": {
        "target_domain": "accounts.google.com",
        "action_name": "browser.inspect",
        "operation_type": "read",
        "production_mode": false,
        "user_present": false
      },
      "expected": {
        "compliance_decision": "BLOCK",
        "site_capability": "AUTOMATION_BLOCKED",
        "browser_automation_allowed": false,
        "api_connector_required": false,
        "block_reason": "GOOGLE_LOGIN_AUTOMATION_BLOCKED",
        "safe_to_dispatch": false,
        "safe_to_execute": false
      }
    },
    {
      "case_id": "gmail_requires_oauth_api",
      "description": "Gmail은 OAuth API 필수, 브라우저 자동화 차단",
      "input": {
        "target_domain": "mail.google.com",
        "action_name": "browser.plan_open_url",
        "operation_type": "navigate",
        "production_mode": false,
        "user_present": false
      },
      "expected": {
        "compliance_decision": "REQUIRE_API_CONNECTOR",
        "site_capability": "OAUTH_API_ONLY",
        "browser_automation_allowed": false,
        "api_connector_required": true,
        "block_reason": "OAUTH_API_REQUIRED",
        "safe_to_dispatch": false,
        "safe_to_execute": false
      }
    },
