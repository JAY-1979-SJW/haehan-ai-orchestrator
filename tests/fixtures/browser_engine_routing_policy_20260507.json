{
  "version": "1.0",
  "date": "2026-05-07",
  "description": "Browser Engine Routing Policy fixture",
  "cases": [
    {
      "id": "about_blank_routes_server_playwright",
      "description": "about:blank는 SERVER_PLAYWRIGHT_READONLY 라우팅",
      "input": {
        "site_category": "test_page",
        "target_domain": "",
        "target_url": "about:blank",
        "operation_type": "read",
        "production_mode": false
      },
      "expected_classification": "SERVER_PLAYWRIGHT_READONLY_ALLOWED",
      "expected_routing": {
        "routing_decision": "ROUTE_SERVER_PLAYWRIGHT_READONLY",
        "selected_engine": "server_playwright",
        "server_playwright_first_allowed": true
      },
      "expected_fallback_policy": {
        "local_agent_fallback_allowed": true
      },
      "expected_security_policy": {
        "safe_to_execute": false
      }
    },
    {
      "id": "data_url_routes_server_playwright",
