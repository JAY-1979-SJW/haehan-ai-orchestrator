    {
      "id": "server_playwright_runtime_failure_fallback_local_agent",
      "description": "허용 사이트에서 runtime failure 발생 시 local agent fallback 가능",
      "input": {
        "site_category": "g2b_public_readonly",
        "target_domain": "g2b.go.kr",
        "target_url": "https://www.g2b.go.kr/notice",
        "operation_type": "read",
        "production_mode": false,
        "failure_reason": "runtime_error"
      },
      "expected_classification": "SERVER_PLAYWRIGHT_READONLY_ALLOWED",
      "expected_routing": {
        "routing_decision": "ROUTE_SERVER_PLAYWRIGHT_READONLY",
        "selected_engine": "server_playwright",
        "server_playwright_first_allowed": true
      },
      "expected_fallback_policy": {
        "local_agent_fallback_allowed": true,
        "_fallback_should_trigger": true
      },
      "expected_security_policy": {
        "safe_to_execute": false
      }
    },
    {
      "id": "server_playwright_policy_block_no_fallback",
      "description": "policy_blocked failure는 fallback 불가",
      "input": {
        "site_category": "hometax",
        "target_domain": "hometax.go.kr",
        "target_url": "https://www.hometax.go.kr/",
        "operation_type": "read",
        "requires_certificate": true,
        "production_mode": false,
        "failure_reason": "policy_blocked"
      },
      "expected_classification": "LOCAL_SYSTEM_BROWSER_USER_PRESENT_REQUIRED",
      "expected_routing": {
        "routing_decision": "ROUTE_LOCAL_SYSTEM_BROWSER_USER_PRESENT",
        "selected_engine": "local_system_browser",
        "server_playwright_first_allowed": false
      },
      "expected_fallback_policy": {
        "local_agent_fallback_allowed": false,
        "_fallback_should_trigger": false
      },
      "expected_security_policy": {
        "safe_to_execute": false,
        "user_present_required": true
      }
    },
