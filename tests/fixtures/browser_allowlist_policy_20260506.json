{
  "policy_id": "BROWSER_ALLOWLIST_POLICY_DESIGN_1",
  "version": "1.0",
  "created_at": "2026-05-06",
  "description": "Browser action URL allowlist policy design. Schema/metadata only. No real execution.",
  "production_allowed": false,
  "dry_run_only": true,
  "dispatcher_connected": false,
  "task_executor_connected": false,
  "operation_types": ["read", "navigate", "open_url", "click", "type", "submit"],
  "default_verdicts": {
    "read":     "ALLOW",
    "navigate": "ALLOW_IF_DOMAIN_ALLOWLISTED",
    "open_url": "ALLOW_IF_DOMAIN_ALLOWLISTED",
    "click":    "ALLOW_IF_APPROVED",
    "type":     "ALLOW_IF_APPROVED_AND_NO_SENSITIVE",
    "submit":   "DENY_BY_DEFAULT"
  },
  "policies": [
    {
      "policy_name": "inspect_read_allow",
      "action_name": "browser.inspect",
      "operation_type": "read",
      "domain": "example.com",
      "url_pattern": "https://example.com/*",
      "allowlist_required": false,
      "approval_required": false,
      "audit_required": false,
      "audit_recommended": true,
      "production_allowed": false,
      "dry_run_only": true,
      "tenant_scope": "internal_test",
      "expected_verdict": "ALLOW",
      "note": "케이스 1: inspect/read action 허용"
    },
    {
      "policy_name": "open_url_controlled_allow",
      "action_name": "browser.open_url_controlled",
      "operation_type": "open_url",
      "domain": "example.com",
      "url_pattern": "https://example.com/*",
      "allowlist_required": true,
      "approval_required": true,
      "audit_required": false,
      "audit_recommended": true,
      "production_allowed": false,
      "dry_run_only": true,
      "tenant_scope": "internal_test",
      "expected_verdict": "ALLOW_IF_DOMAIN_ALLOWLISTED",
      "note": "케이스 2: open_url controlled 허용 후보 - domain이 allowlist에 있을 때만 허용"
    },
    {
      "policy_name": "unknown_domain_deny",
      "action_name": "browser.open_url_controlled",
      "operation_type": "open_url",
      "domain": "unknown-random-9x7z.example.invalid",
      "url_pattern": "https://unknown-random-9x7z.example.invalid/*",
      "allowlist_required": true,
      "approval_required": true,
      "audit_required": false,
      "production_allowed": false,
      "dry_run_only": true,
      "tenant_scope": "internal_test",
      "expected_verdict": "DENY",
      "deny_reason": "domain not in allowlist",
      "note": "케이스 3: unknown domain deny"
    },
    {
      "policy_name": "wildcard_only_domain_deny",
      "action_name": "browser.open_url_controlled",
      "operation_type": "open_url",
      "domain": "*",
      "url_pattern": "*",
      "allowlist_required": true,
      "approval_required": false,
      "audit_required": false,
      "production_allowed": false,
      "dry_run_only": true,
      "tenant_scope": "internal_test",
      "expected_verdict": "DENY",
      "deny_reason": "wildcard-only domain not allowed",
      "note": "케이스 4: wildcard-only domain deny - * 단독 사용 금지"
    },
    {
      "policy_name": "click_approval_required",
      "action_name": "browser.execute_click",
      "operation_type": "click",
      "domain": "example.com",
      "url_pattern": "https://example.com/board/*",
      "allowlist_required": true,
      "approval_required": true,
      "audit_required": true,
      "production_allowed": false,
      "dry_run_only": true,
      "tenant_scope": "internal_test",
      "expected_verdict": "ALLOW_IF_APPROVED",
      "note": "케이스 5: click action approval required"
    },
    {
      "policy_name": "type_approval_required",
      "action_name": "browser.execute_type",
      "operation_type": "type",
      "domain": "example.com",
      "url_pattern": "https://example.com/search/*",
      "allowlist_required": true,
      "approval_required": true,
      "audit_required": true,
      "sensitive_field_block": true,
      "production_allowed": false,
      "dry_run_only": true,
      "tenant_scope": "internal_test",
      "expected_verdict": "ALLOW_IF_APPROVED_AND_NO_SENSITIVE",
      "note": "케이스 6: type action approval required + sensitive field block"
    },
    {
      "policy_name": "submit_default_deny",
      "action_name": "browser.open_type_close_controlled",
      "operation_type": "submit",
      "domain": "example.com",
      "url_pattern": "https://example.com/form/*",
      "allowlist_required": true,
      "approval_required": true,
      "audit_required": true,
      "production_allowed": false,
      "dry_run_only": true,
      "tenant_scope": "internal_test",
      "expected_verdict": "DENY_BY_DEFAULT",
      "deny_reason": "submit operation requires explicit gate_module approval - not yet implemented",
      "note": "케이스 7: submit action 기본 deny - gate_module 미구현"
    },
    {
      "policy_name": "production_allowed_true_deny",
      "action_name": "browser.execute_click",
      "operation_type": "click",
      "domain": "example.com",
      "url_pattern": "https://example.com/*",
      "allowlist_required": true,
      "approval_required": true,
      "audit_required": true,
      "production_allowed": true,
      "dry_run_only": false,
      "tenant_scope": "internal_test",
      "expected_verdict": "DENY",
      "deny_reason": "production_allowed=true is blocked in this stage",
      "note": "케이스 8: production_allowed=true 차단 - 현 단계 전면 금지"
    },
    {
      "policy_name": "password_secret_intent_deny",
      "action_name": "browser.execute_type",
      "operation_type": "type",
      "domain": "example.com",
      "url_pattern": "https://example.com/login/*",
      "allowlist_required": true,
      "approval_required": true,
      "audit_required": true,
      "sensitive_field_block": true,
      "intent": "fill_password_field",
      "production_allowed": false,
      "dry_run_only": true,
      "tenant_scope": "internal_test",
      "expected_verdict": "DENY",
      "deny_reason": "password/secret intent detected - sensitive_field_block active",
      "note": "케이스 9: password/secret 입력 intent deny"
    },
    {
      "policy_name": "tenant_scope_missing_deny",
      "action_name": "browser.execute_click",
      "operation_type": "click",
      "domain": "example.com",
      "url_pattern": "https://example.com/*",
      "allowlist_required": true,
      "approval_required": true,
      "audit_required": true,
      "production_allowed": false,
      "dry_run_only": true,
      "tenant_scope": null,
      "expected_verdict": "DENY",
      "deny_reason": "tenant_scope missing",
      "note": "케이스 10: tenant_scope 누락 deny"
    },
    {
      "policy_name": "audit_required_missing_deny",
      "action_name": "browser.execute_type",
      "operation_type": "type",
      "domain": "example.com",
      "url_pattern": "https://example.com/form/*",
      "allowlist_required": true,
      "approval_required": true,
      "audit_required": false,
      "production_allowed": false,
      "dry_run_only": true,
      "tenant_scope": "internal_test",
      "expected_verdict": "DENY",
      "deny_reason": "audit_required must be true for type/click/submit operations",
      "note": "케이스 11: type operation에서 audit_required=false이면 deny"
    },
    {
      "policy_name": "business_site_policy_placeholder",
      "action_name": "browser.open_url_controlled",
      "operation_type": "open_url",
      "domain": "PLACEHOLDER_BUSINESS_SITE",
      "url_pattern": "PLACEHOLDER_NOT_EXECUTABLE",
      "allowlist_required": true,
      "approval_required": true,
      "audit_required": true,
      "production_allowed": false,
      "dry_run_only": true,
      "tenant_scope": "business_test",
      "expected_verdict": "PENDING_POLICY_DESIGN",
      "deny_reason": "실제 업무 사이트는 별도 정책 설계 필요 - 이번 단계에서 실행 불가",
      "note": "케이스 12: g2b 등 실제 업무 사이트는 정책 필요성 문서화만. 실행 가능한 URL fixture 아님"
    }
  ],
  "action_allowlist_mapping": {
    "browser.inspect":                  {"allowlist_required": false, "operation_type": "read"},
    "browser.plan_click":               {"allowlist_required": false, "operation_type": "read"},
    "browser.plan_open_url":            {"allowlist_required": true,  "operation_type": "navigate"},
    "browser.open_url_controlled":      {"allowlist_required": true,  "operation_type": "open_url"},
    "browser.execute_click":            {"allowlist_required": true,  "operation_type": "click"},
    "browser.execute_type":             {"allowlist_required": true,  "operation_type": "type"},
    "browser.open_click_close_controlled": {"allowlist_required": true, "operation_type": "click"},
    "browser.open_type_close_controlled":  {"allowlist_required": true, "operation_type": "submit"}
  }
}
