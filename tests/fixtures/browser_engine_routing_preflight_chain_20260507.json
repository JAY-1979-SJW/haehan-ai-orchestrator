{
  "version": "1.0",
  "date": "2026-05-07",
  "description": "Browser Engine Routing Preflight Chain fixture",
  "cases": [
    {
      "id": "about_blank_server_readonly_chain",
      "description": "about:blank는 서버 Playwright preflight chain 통과",
      "input": {"target_url": "about:blank", "operation_type": "read", "production_mode": false},
      "expected_classification": "SERVER_PLAYWRIGHT_READONLY_ALLOWED",
      "expected_routing": {"routing_decision": "ROUTE_SERVER_PLAYWRIGHT_READONLY"},
      "expected_fallback_policy": {"local_agent_fallback_allowed": true},
      "expected_security_policy": {"safe_to_execute": false, "next_step": "SERVER_PLAYWRIGHT_READONLY_PREFLIGHT"}
    },
    {
      "id": "example_com_server_readonly_chain",
      "description": "example.com은 서버 Playwright preflight chain 통과",
      "input": {"site_category": "example", "target_domain": "example.com", "target_url": "https://example.com/", "operation_type": "read", "production_mode": false},
      "expected_classification": "SERVER_PLAYWRIGHT_READONLY_ALLOWED",
      "expected_routing": {"routing_decision": "ROUTE_SERVER_PLAYWRIGHT_READONLY"},
      "expected_fallback_policy": {"local_agent_fallback_allowed": true},
      "expected_security_policy": {"safe_to_execute": false, "next_step": "SERVER_PLAYWRIGHT_READONLY_PREFLIGHT"}
