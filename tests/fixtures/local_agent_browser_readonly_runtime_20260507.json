        "target_domain": "g2b.go.kr",
        "operation_type": "readonly_search",
        "production_mode": false,
        "dry_run": true
      },
      "expected_runtime_policy": {
        "runtime_decision": "READONLY_ALLOWED",
        "readonly_execution": true,
        "user_present_required": false,
