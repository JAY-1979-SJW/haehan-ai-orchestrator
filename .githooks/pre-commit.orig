#!/usr/bin/env python
import os, subprocess, sys
from pathlib import Path

# Windows 기본 코드페이지(cp949)에서 em-dash 등 유니코드 문자를 _run_relay 가 그대로
# sys.stdout.write 하면 UnicodeEncodeError 로 훅 전체가 죽는 문제(2026-10-09, W3 3회+
# 재발 — commit-msg 훅엔 이미 있던 reconfigure 가 여기엔 없었음). 이 프로세스 자신의
# stdout/stderr 를 utf-8 로 강제하고, PYTHONUTF8/PYTHONIOENCODING 을 환경에 심어 아래
# 비캡처(inherit stdio) 자식 프로세스(mp/th/fr/bp/fg/rc 등)에도 같은 효과가 전파되게 한다.
sys.stdout.reconfigure(encoding="utf-8", errors="replace")
sys.stderr.reconfigure(encoding="utf-8", errors="replace")
os.environ.setdefault("PYTHONUTF8", "1")
os.environ.setdefault("PYTHONIOENCODING", "utf-8")


def _run_relay(name, cmd, **kw):
    # CREATE_NO_WINDOW + 콘솔 미상속 조합에서 자식 stdout/stderr 가 조용히 사라지는 문제(2026-10-08
    # W2·W4 "체크리스트 PASS 뒤 무출력 exit 1") 진단용 — 캡처해서 부모 stdout/stderr 로 그대로 relay.
    kw.pop("capture_output", None)
    proc = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8", errors="replace", **kw)
    if proc.stdout:
        sys.stdout.write(proc.stdout)
    if proc.stderr:
        sys.stderr.write(proc.stderr)
    if proc.returncode != 0:
        print(f"[{name}] exit={proc.returncode}", file=sys.stderr)
    return proc


def _no_window():
    # scripts/ops/_proc.no_window_kwargs 와 같은 로직을 그대로 둔다 — 이 파일은
    # core.hooksPath 로 여러 worktree 가 공유해 __file__ 기준 import 가 항상 메인
    # 체크아웃을 가리켜(2026-09-28 실측), scripts/ops/_proc.py 를 import하면 그
    # 워크트리의 수정 전 사본을 보거나 아직 없으면 전원 커밋이 막힌다. 그래서
    # 복사 대신 같은 3줄을 이 파일에도 둔다(콘솔 깜빡임 수정, 2026-10-07).
    return {"creationflags": subprocess.CREATE_NO_WINDOW} if sys.platform == "win32" else {}


ROOT = Path(
    subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True, text=True, check=True, **_no_window(),
    ).stdout.strip()
)  # __file__ 기준이면 core.hooksPath 공유 시 worktree 에서도 항상 메인 체크아웃을
# 가리켜 내용을 조용히 훼손한다(2026-09-28 worktree 병렬 세션에서 실측 발견).
# 실행 시점 cwd(git 이 훅에 주는 실제 worktree 루트) 기준으로 고정.


def _pyexe():
    # Windows py 런처로 프로젝트 고정 버전(3.14) 우선 — PATH의 "python"이 다른 버전
    # (예: 3.11)을 가리키면 그 버전엔 없는 패키지(예: audit_kit)가 없어 훅이 실패한다
    # (admin-web/electron/lib/agent.js resolvePython() 과 동일 사유, 2026-09-29
    # pre-push 훅에서 실측: "No module named audit_kit").
    import shutil

    if shutil.which("py"):
        try:
            subprocess.run(["py", "-3.14", "--version"], capture_output=True, check=True, **_no_window())
            return ["py", "-3.14"]
        except Exception:
            pass
    return [sys.executable]


def _diff_cached_batched(files, extra_args=(), batch=200, **kw):
    # git diff --cached -- <files> 도 같은 WinError 206 위험 — 묶음별 stdout 을
    # 그대로 이어붙인다(각 묶음은 독립된 diff 구간이라 합쳐도 내용이 그대로 보존됨).
    out = []
    for i in range(0, len(files), batch):
        chunk = files[i:i + batch]
        _r = subprocess.run(
            ["git", "diff", "--cached", *extra_args, "--"] + chunk,
            cwd=str(ROOT), capture_output=True, text=True,
            encoding="utf-8", errors="replace", **kw,
        )
        out.append(_r.stdout)
    return "\n".join(out)


def _run_batched(build_cmd, files, batch=200, **kw):
    # Windows 명령줄 길이 제한(WinError 206, 2026-10-08 실측: 변경파일 1200개+로
    # 한 번에 넘기면 CreateProcess 가 죽음) — files 를 batch개씩 나눠 같은 검사를
    # 그대로 반복 실행. 한 묶음이라도 실패하면 즉시 멈추고 그 결과를 반환한다
    # (건너뛰기·예외 없음 — 나머지 묶음은 실행되지 않을 뿐 검사를 통과한 게 아니다).
    last = subprocess.CompletedProcess([], 0)
    for i in range(0, len(files), batch):
        chunk = files[i:i + batch]
        last = subprocess.run(build_cmd(chunk), cwd=str(ROOT), **kw)
        if last.returncode != 0:
            return last
    return last


# staged .py 파일 목록
# encoding 명시: Windows 기본 코드페이지(cp949)가 diff에 섞인 UTF-8 특수문자에서
# reader 스레드를 죽이는 문제 방지(2026-09-28 실측 발견 — 이 문제로 훅이 크래시했었음).
r = subprocess.run(
    ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
    cwd=str(ROOT), capture_output=True, text=True,
    encoding="utf-8", errors="replace", **_no_window(),
)
py_files = [f for f in r.stdout.splitlines() if f.endswith(".py")]

if py_files:
    cfg = str(ROOT / "configs" / "ruff.toml")
    # 자동 수정·포맷은 이번 커밋에서 "새로 추가된(A)" 파일에만 적용한다.
    # 기존 파일에 적용하면 한 줄 수정도 파일 전체 기존 오류 정리·재포맷을 강제해
    # 대량 서식 변경과 커밋 차단이 생긴다(defect_index #30, 2026-10-01).
    # 기존 파일은 아래 3단계의 "새로 생긴 위반만 차단"으로 충분하다.
    _ra = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=A"],
        cwd=str(ROOT), capture_output=True, text=True,
        encoding="utf-8", errors="replace", **_no_window(),
    )
    _added = set(_ra.stdout.splitlines())
    fix_files = [f for f in py_files if f in _added]
    if fix_files:
        # 1. ruff check (자동 수정). F401 은 자동수정 제외 — 파사드의 재노출 import
        #    (mock.patch 대상·하위 호환 이름)를 '미사용'으로 지워 조용히 깨뜨린다
        #    (defect_index #33, #93, #110 에서 반복 발생).
        _run_batched(
            lambda chunk: [*_pyexe(), "-m", "ruff", "check", "--fix", "--unfixable", "F401",
                           "--config", cfg] + chunk,
            fix_files, **_no_window(),
        )
        # 2. ruff format
        _run_batched(
            lambda chunk: [*_pyexe(), "-m", "ruff", "format", "--config", cfg] + chunk,
            fix_files, **_no_window(),
        )
        # ruff 가 수정한 신규 파일을 다시 stage
        _run_batched(lambda chunk: ["git", "add"] + chunk, fix_files, **_no_window())
    # 3. 자동수정 안 되는 나머지 위반은 "이번 커밋으로 새로 생긴 것"만 차단한다.
    #    (BLE001 같은 대규모 기존 부채가 있는 파일을 조금만 건드려도 매번 전체가
    #    막히면 사실상 개발이 정지된다 — CLAUDE.md "새 훅은 새로 생긴 오류만
    #    차단" 원칙을 실제로 구현, 2026-09-28)
    gate = ROOT / "scripts" / "ops" / "ruff_new_only_gate.py"
    if gate.exists():
        gate_result = _run_batched(
            lambda chunk: [*_pyexe(), str(gate), "--config", cfg] + chunk,
            py_files, **_no_window(),
        )
        if gate_result.returncode != 0:
            print("[ruff] 이번 변경으로 새로 생긴 위반이 있습니다. 위 내용을 확인하고 재커밋하세요.")
            sys.exit(1)

# ── 로그인 세션 파기 코드 차단 ───────────────────────────────────────
# 세션을 임의 로그아웃/쿠키삭제하면 '매번 재로그인' 문제 발생(CLAUDE.md 로그인 세션 보존).
# staged .py 에 세션 파기 패턴이 추가되면 차단. 정당한 로그아웃이면 줄에 '# session-ok'.
# (이 훅 설치 파일 자신은 패턴을 데이터로 가지므로 제외)
_sg_files = [f for f in py_files if not f.endswith("install_git_hooks.py")]
if _sg_files:
    _sdiff_text = _diff_cached_batched(_sg_files, extra_args=["-U0"], **_no_window())
    _sess_pat = (
        "nidlogin.logout", "logout.naver", "clear_cookies", "delete_cookies",
        "deleteallcookies", "cookies.clear", "context.clear_cookies",
    )
    _sess_bad = []
    for _ln in _sdiff_text.splitlines():
        if _ln.startswith("+") and not _ln.startswith("+++"):
            _body = _ln[1:]
            if "session-ok" in _body:
                continue
            _low = _body.lower()
            if any(_pp in _low for _pp in _sess_pat):
                _sess_bad.append(_body.strip())
    if _sess_bad:
        print("=" * 60)
        print("[session-guard] 로그인 세션 파기 코드 감지 — 매번 재로그인 유발:")
        for _b in _sess_bad[:8]:
            print("    + " + _b[:90])
        print("    세션은 유지해야 합니다(CLAUDE.md 로그인 세션 보존).")
        print("    정당한 로그아웃이면 해당 줄에 '# session-ok' 주석을 추가하세요.")
        print("=" * 60)
        sys.exit(1)

# ── 소스 실행 방식 강제 ──────────────────────────────────────────────
# launcher(start_haehan_ai.ps1)가 frozen exe / Next standalone 빌드본을 '실행'하면 차단.
# 백엔드=uvicorn 소스, 프론트=next dev 소스 유지(재빌드 불필요). 정당한 예외는 파일에 '# source-ok'.
all_staged = r.stdout.splitlines()
if "scripts/start_haehan_ai.ps1" in all_staged:
    try:
        _txt = (ROOT / "scripts" / "start_haehan_ai.ps1").read_text(encoding="utf-8", errors="replace")
    except Exception:
        _txt = ""
    if "# source-ok" not in _txt:
        _bad = []
        if "Start-Process $FASTAPI" in _txt:
            _bad.append("FastAPI를 frozen exe로 실행 — uvicorn 소스로 유지하세요")
        if "-ArgumentList $NEXTJS" in _txt:
            _bad.append("Next를 standalone 빌드본(server.js)으로 실행 — next dev 소스로 유지하세요")
        if "uvicorn" not in _txt:
            _bad.append("uvicorn(소스 백엔드) 실행 흔적이 없습니다")
        if '"dev"' not in _txt:
            _bad.append("next dev(소스 프론트) 실행 흔적이 없습니다")
        if _bad:
            print("=" * 60)
            print("[source-only] launcher가 소스 실행 방식을 벗어났습니다 (재빌드 금지):")
            for _b in _bad:
                print("    - " + _b)
            print("    백엔드=uvicorn 소스, 프론트=next dev 소스로 유지하세요.")
            print("    정당한 예외면 start_haehan_ai.ps1 에 '# source-ok' 주석을 추가하세요.")
            print("=" * 60)
            sys.exit(1)

# ── windowsHide 누락 차단 (JS/Electron spawn) ───────────────────────────────
# Windows에서 windowsHide 없이 spawn하면 콘솔 창이 튀어나옴(터미널 창 문제 재발 방지).
_js_staged = [f for f in r.stdout.splitlines()
              if f.startswith("admin-web/electron/") and f.endswith(".js")]
if _js_staged:
    import re as _re
    _spawn_pat = _re.compile(r"\bspawn\s*\(")
    _hide_pat = _re.compile(r"windowsHide\s*:\s*true")
    _jsdiff_text = _diff_cached_batched(_js_staged, extra_args=["-U5"], **_no_window())
    _chunks, _cur = [], []
    for _ln in _jsdiff_text.splitlines():
        if _ln.startswith("@@"):
            if _cur: _chunks.append("\n".join(_cur))
            _cur = [_ln]
        else:
            _cur.append(_ln)
    if _cur: _chunks.append("\n".join(_cur))
    _win_bad = []
    for _chunk in _chunks:
        _added = "\n".join(l[1:] for l in _chunk.splitlines() if l.startswith("+") and not l.startswith("+++"))
        if _spawn_pat.search(_added) and not _hide_pat.search(_chunk):
            _ctx = _added[:120].replace("\n", " | ")
            _win_bad.append(_ctx)
    if _win_bad:
        print("=" * 60)
        print("[windowsHide-guard] spawn() 에 windowsHide:true 없음 — 터미널 창 유발 위험:")
        for _w in _win_bad[:5]:
            print("    " + _w)
        print("    spawn() 옵션에 windowsHide: true 를 추가하세요.")
        print("=" * 60)
        sys.exit(1)

# ── 지도↔골격 대조 게이트 (skeleton_gate) ────────────────────────────────
# 정본(module_registry.json)이 스테이지된 A/D/R 코드 파일·추적 파일과 어긋나면 차단.
# 우회: SKELETON_GATE_SKIP_REASON="사유" 환경변수 (감사 로그 기록됨).
_sg = ROOT / "scripts" / "ops" / "code_map" / "skeleton_gate.py"
if _sg.exists():
    _sg_result = _run_relay("skeleton_gate", [*_pyexe(), str(_sg)], cwd=str(ROOT), **_no_window())
    if _sg_result.returncode != 0:
        sys.exit(_sg_result.returncode)

# ── audit-kit 개발 기준서 게이트 (staged .py 의 신규 문제만 차단) ──────────
# audit-kit 를 못 찾으면 건너뛰지만 AUDIT_KIT_REQUIRED=1 이면 커밋을 막는다.
_ak = ROOT / "scripts" / "ops" / "audit_kit_gate.py"
if _ak.exists():
    _ak_result = _run_relay("audit_kit_gate", [*_pyexe(), str(_ak), "--staged"], cwd=str(ROOT), **_no_window())
    if _ak_result.returncode != 0:
        sys.exit(_ak_result.returncode)

# ── 이동 사전점검 게이트 (git mv 한 .py 의 남은 경로 로드/직접 실행 참조) ──────
# alias 한 줄 shim 은 import 만 받는다. 파일 경로 로드·직접 실행·설정/훅 경로 참조가 새 경로로 안 고쳐졌고
# 옛 경로에 맞는 shim 도 없으면 커밋을 막는다(2026-10-07 hiworks·dashboard 회귀).
# 해결: python tools/devflow/make_shim.py <옛> <새> 또는 참조를 새 경로로 수정. 우회 옵션 없음.
_mp = ROOT / "scripts" / "ops" / "move_preflight.py"
if _mp.exists() and any(
    ln.startswith("R") and ln.split("\t")[-1].endswith(".py")
    for ln in subprocess.run(
        ["git", "diff", "--cached", "--name-status", "-M", "--diff-filter=R"],
        cwd=str(ROOT), capture_output=True, text=True, encoding="utf-8", errors="replace",
    ).stdout.splitlines()
):
    _mp_result = subprocess.run([*_pyexe(), str(_mp), "--staged-renames"], cwd=str(ROOT))
    if _mp_result.returncode != 0:
        sys.exit(_mp_result.returncode)

# ── 도구 집 게이트 (도구 키워드 새 파일이 집 밖이면 차단 — G11) ─────────────────
# 새로 추가(A)·이름변경(R)된 .py/.ts/.tsx 가 도구 집(scripts/<도구>/·connectors/<도구>/·화면 폴더) 밖이면 차단.
# 기존 집 밖 파일은 configs/tool_home_baseline.json 으로 고정(수정은 통과). 우회 옵션 없음.
_th = ROOT / "scripts" / "ops" / "tool_home_gate.py"
if _th.exists() and any(
    f.endswith((".py", ".ts", ".tsx"))
    for f in subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=AR"],
        cwd=str(ROOT), capture_output=True, text=True, encoding="utf-8", errors="replace",
    ).stdout.splitlines()
):
    _th_result = subprocess.run([*_pyexe(), str(_th), "--staged"], cwd=str(ROOT))
    if _th_result.returncode != 0:
        sys.exit(_th_result.returncode)

# ── 최상위 평면 금지 게이트 (scripts/*.py·ai_orchestrator/*.py·루트 *.py 에 새 파일 차단 — G15) ──────
# 새로 추가(A)·이름변경(R)된 .py 가 평면 금지 폴더 바로 아래면 차단. 기존 평면 파일은 configs/flat_root_baseline.json 으로
# 고정(수정·삭제는 통과). 진입점(asgi·router·config·app·__init__·conftest·sitecustomize)은 허용. 우회 옵션 없음.
_fr = ROOT / "scripts" / "ops" / "flat_root_gate.py"
if _fr.exists() and any(
    f.endswith(".py")
    for f in subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=AR"],
        cwd=str(ROOT), capture_output=True, text=True, encoding="utf-8", errors="replace",
    ).stdout.splitlines()
):
    _fr_result = subprocess.run([*_pyexe(), str(_fr), "--staged"], cwd=str(ROOT))
    if _fr_result.returncode != 0:
        sys.exit(_fr_result.returncode)

# ── 번들 경로 일관성 게이트 (spec·electron-builder·electron js·릴리스 워크플로의 깨진 경로/모듈 차단 — G17) ──
# 폴더 이동 뒤 PyInstaller spec 진입 파일·hiddenimports·datas, package.json extraResources, lib/*.js 의
# process.resourcesPath 경로, desktop-release.yml 경로가 그대로 남아 데스크톱 앱이 반복해 깨졌다(2026-10-08).
# *.spec·package.json·admin-web/electron/**·.github/workflows/**·spec 에 이름이 적힌 .py 가 staged 일 때만
# 게이트 안에서 판정해 전체 검사한다(아니면 즉시 통과). 우회 옵션 없음.
_bp = ROOT / "scripts" / "ops" / "bundle_path_gate.py"
if _bp.exists():
    _bp_result = subprocess.run([*_pyexe(), str(_bp), "--staged"], cwd=str(ROOT))
    if _bp_result.returncode != 0:
        sys.exit(_bp_result.returncode)

# ── 폴더 승인 게이트 (승인 목록에 없는 폴더에 새 코드 파일 차단 — G16) ────────────────────────
# 새로 추가(A)·이름변경(R)된 코드(.py·.ts·.tsx·.js)의 폴더가 configs/folder_registry.json 에 없으면 차단. 새 폴더는 대표님 승인 후 목록에 추가
# (PR 라벨 folder-approved 는 CI 가 확인). 삭제·기존 파일 수정은 보지 않는다. 우회 옵션 없음.
_fg = ROOT / "scripts" / "ops" / "folder_gate.py"
if _fg.exists() and any(
    f.endswith((".py", ".ts", ".tsx", ".js"))
    for f in subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=AR"],
        cwd=str(ROOT), capture_output=True, text=True, encoding="utf-8", errors="replace",
    ).stdout.splitlines()
):
    _fg_result = subprocess.run([*_pyexe(), str(_fg), "--staged"], cwd=str(ROOT))
    if _fg_result.returncode != 0:
        sys.exit(_fg_result.returncode)

# ── 루트 직접 계산 차단 게이트 (G5 — 새로 추가된 줄만) ───────────────────────────
# Path(__file__).parents[N] / .parent.parent / dirname(dirname(__file__)) 로 저장소 루트를 파일마다 따로 계산하는
# 새 줄이 있으면 차단 → ai_orchestrator.paths.repo_root / scripts.common.app_paths.repo_root 사용. 기존 줄은 막지 않는다.
# 우회 옵션 없음(예외: configs/root_calc_gate.json 에 사유와 함께).
_rc = ROOT / "scripts" / "ops" / "root_calc_gate.py"
if _rc.exists() and py_files:
    _rc_result = subprocess.run([*_pyexe(), str(_rc), "--staged"], cwd=str(ROOT))
    if _rc_result.returncode != 0:
        sys.exit(_rc_result.returncode)

# ── R1 API 계약 게이트 (화면↔서버 끊긴 호출 신규분만 차단) ────────────────
# admin-web/src 또는 FastAPI 라우터(ai_orchestrator)가 staged일 때만 실행 —
# 영향 테스트 선택만으로는 admin-web 단독 변경 시 전혀 안 돌아서(2026-10-07
# 지휘창 지적) 훅에 직접 연결. 기존 끊긴 호출(허용목록)은 통과, 신규만 차단.
_r1_staged = [
    f for f in r.stdout.splitlines()
    if f.startswith("admin-web/src/") or f.startswith("ai_orchestrator/")
]
if _r1_staged:
    _r1 = ROOT / "scripts" / "ops" / "audit_r1_api_contract_gate.py"
    if _r1.exists():
        _r1_result = _run_relay("r1_api_contract_gate", [*_pyexe(), str(_r1)], cwd=str(ROOT), **_no_window())
        if _r1_result.returncode != 0:
            sys.exit(_r1_result.returncode)

# ── G12 중복 게이트 (새 구조동일 중복 함수만 차단) ──────────────────────────
# 이름·상수를 지운 AST 해시가 같은 함수(4문장 이상)가 다른 파일에 이미 있으면 차단.
# 기존 중복은 configs/dup_baseline.json 기준선으로 고정(새로 생긴 것만 막음).
# 시험 파일·scripts/archive/·apps/ 는 예외. 우회 옵션 없음(기준선 재생성: build-baseline).
_dg = ROOT / "scripts" / "ops" / "dup_gate.py"
if _dg.exists() and py_files:
    _dg_result = _run_batched(
        lambda chunk: [*_pyexe(), str(_dg), "check", *chunk], py_files,
    )
    if _dg_result.returncode != 0:
        sys.exit(_dg_result.returncode)

# 기존 quality gate (pre-commit 내장)
from pathlib import Path as _P
import importlib.util, os
gate = ROOT / "scripts" / "ops" / "quality" / "quality_gate.py"
if gate.exists():
    # 2026-09-30 수정(defect_index #2): 이 훅이 --allow-existing-code-change 를 항상
    # 넘겨서 existing_code_change_requires_flag 안전장치가 영구 무력화돼 있었다.
    # 완전 차단은 비현실적이라 최소한 기존 활성 코드 수정 개수를 콘솔에 드러낸다.
    # (이 블록이 설치 원본에 없어 세션마다 .orig 가 덮어써져 사라지던 것을 2026-10-01 복원)
    try:
        _diff = subprocess.run(
            ["git", "diff", "--cached", "--name-status"],
            cwd=str(ROOT), capture_output=True, text=True, check=True, **_no_window(),
        ).stdout
        _modified = [
            line.split("	", 1)[1] for line in _diff.splitlines()
            if line.startswith("M	") and line.split("	", 1)[1].endswith(".py")
        ]
        if _modified:
            print(f"[quality_gate] 기존 코드 수정 {len(_modified)}개 파일 감지 "
                  f"(--allow-existing-code-change 자동 적용됨):")
            for _m in _modified[:10]:
                print(f"    {_m}")
            if len(_modified) > 10:
                print(f"    ... 외 {len(_modified) - 10}개")
    except (subprocess.CalledProcessError, OSError):
        pass  # 가시성 로그 실패는 커밋을 막지 않음

    result = _run_relay(
        "quality_gate",
        [*_pyexe(), str(gate), "--staged", "--enforce", "--allow-existing-code-change"],
        cwd=str(ROOT), **_no_window(),
    )
    sys.exit(result.returncode)
