#!/usr/bin/env python
"""commit-msg 훅 — 대량 코드 삭제 차단.

staged 변경에서 .py/.ts/.tsx 순삭제(deleted-added) >= 60줄 파일이 있으면 커밋 차단.
커밋 메시지에 [allow-delete] 가 있으면 통과(의도된 삭제 명시).
코드 보존 원칙(기존 코드 무단 삭제 금지) 강제.
"""
import subprocess, sys
from pathlib import Path

ROOT = Path(
    subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
)  # __file__ 기준이면 core.hooksPath 공유 시 worktree 에서도 항상 메인 체크아웃을
# 가리켜 내용을 조용히 훼손한다(2026-09-28 worktree 병렬 세션에서 실측 발견).
# 실행 시점 cwd(git 이 훅에 주는 실제 worktree 루트) 기준으로 고정.
THRESHOLD = 60  # 순삭제 줄 수 기준

# 커밋 메시지
msg_path = sys.argv[1] if len(sys.argv) > 1 else None
message = ""
if msg_path:
    try:
        message = Path(msg_path).read_text(encoding="utf-8")
    except Exception:
        message = ""

if "[allow-delete]" in message:
    sys.exit(0)  # 명시적 허용

# staged 수정/삭제 파일의 add/delete 수
r = subprocess.run(
    ["git", "diff", "--cached", "--numstat", "--diff-filter=MD"],
    cwd=str(ROOT), capture_output=True, text=True,
    encoding="utf-8", errors="replace",  # Windows 기본 코드페이지(cp949)가 UTF-8 경로/내용에서 깨지는 문제 방지(2026-09-28)
)
big = []
for line in r.stdout.splitlines():
    parts = line.split("\t")
    if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
        added, deleted, path = int(parts[0]), int(parts[1]), parts[2]
        if path.endswith((".py", ".ts", ".tsx")) and (deleted - added) >= THRESHOLD:
            big.append((path, deleted, added))

if big:
    print("=" * 60)
    print("[commit-msg] 대량 코드 삭제 차단 — 코드 보존 원칙(기존 코드 무단 삭제 금지)")
    for path, d, a in big:
        print(f"    {path}: -{d}/+{a} (순삭제 {d - a}줄)")
    print("    의도된 삭제면 커밋 메시지에 [allow-delete] 를 넣어 다시 커밋하세요.")
    print("=" * 60)
    sys.exit(1)

sys.exit(0)
